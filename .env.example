# ===================================================================
# URBAN CHECK ATELIER PLATFORM — MASTER ENVIRONMENT BLUEPRINT
# This repository contains three independent workspace applications:
# 1. /server  — Express API, MongoDB, Redis, JWT & Logistics services
# 2. /client  — Customer Luxury Atelier Web Experience (Vite React)
# 3. /admin   — Administrative Control Center & Operations (Vite React)
#
# DO NOT COMMIT REAL CREDENTIALS OR API SECRETS TO REPOSITORIES.
# ===================================================================

# -------------------------------------------------------------------
# Backend Server Configuration (/server/.env)
# -------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

JWT_SECRET=your_customer_jwt_access_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_customer_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_SECRET=your_dedicated_admin_jwt_secret_here
ADMIN_JWT_EXPIRES_IN=1d

MONGODB_URI=mongodb://localhost:27017/urban_check
REDIS_URL=redis://localhost:6379

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

DTDC_API_KEY=your_dtdc_key
DTDC_CUSTOMER_ID=your_dtdc_id
DTDC_API_URL=https://api.dtdc.in/v1

DELHIVERY_API_KEY=your_delhivery_key
DELHIVERY_CLIENT_ID=your_delhivery_id
DELHIVERY_API_URL=https://track.delhivery.com/api

EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM="Urban Check Concierge <concierge@urbancheck.com>"

# -------------------------------------------------------------------
# Customer Client Configuration (/client/.env)
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# -------------------------------------------------------------------
# Admin Console Configuration (/admin/.env)
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
