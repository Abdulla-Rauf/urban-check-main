# ===================================================================
# URBAN CHECK BACKEND SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your local or production values.
# NEVER COMMIT REAL PRODUCTION CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ===================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS Dual-Frontend Architecture)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Authentication & JWT Secrets (Use 64+ character random strings in production)
JWT_SECRET=replace_with_secure_random_customer_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_jwt_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_secure_random_admin_jwt_secret_min_32_chars
ADMIN_JWT_EXPIRES_IN=1d

# Database Configuration
# Local: mongodb://localhost:27017/urban_check
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/urban_check?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/urban_check
REDIS_URL=redis://localhost:6379

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Logistics & Courier Providers
DTDC_API_KEY=your_dtdc_api_key_here
DTDC_CUSTOMER_ID=your_dtdc_customer_id_here
DTDC_API_URL=https://api.dtdc.in/v1

DELHIVERY_API_KEY=your_delhivery_api_key_here
DELHIVERY_CLIENT_ID=your_delhivery_client_id_here
DELHIVERY_API_URL=https://track.delhivery.com/api

# Email Service Configuration (SMTP / Mailtrap)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Urban Check Concierge <concierge@urbancheck.com>"
